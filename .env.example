# Public deployment configuration; keep RPC credentials outside version control.
DEPLOY_CONFIG=config/deployment.local.json
RPC_URL=https://YOUR_RPC_ENDPOINT
# An unlocked public sender address for simulation; use a keystore for broadcasting.
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000
# Set after deployment for read-only verification and owner action generation.
SWEEPER_ADDRESS=0x0000000000000000000000000000000000000000
# Optional, local fork testing only. Never broadcasts.
# FORK_RPC_URL=https://YOUR_RPC_ENDPOINT
# FORK_TOKEN=0x0000000000000000000000000000000000000000
# FORK_BLOCK_NUMBER=0
